NODE_ENV=development
PORT=5000

# Neon connection string — from your Neon project dashboard, "Connection Details".
# Use the pooled connection string (contains "-pooler" in the hostname) for the
# running app; the direct (non-pooled) one is only needed for running migrations.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/ain_rwanda?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxxx.region.aws.neon.tech/ain_rwanda?sslmode=require

JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
