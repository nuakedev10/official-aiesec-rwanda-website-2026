NODE_ENV=development
PORT=5000

# Get these from your Neon project dashboard -> "Connection Details".
# Copy each string WHOLE and paste it in directly — don't hand-edit one
# into the other. The placeholders below are intentionally obviously fake
# (EXAMPLE/xx-example-1) specifically so a half-replaced value is easy to
# spot; a real Neon hostname looks like
# ep-cool-name-a1b2c3d4.us-east-2.aws.neon.tech, with an actual AWS region
# in that spot, not the literal word "region".
#
# DATABASE_URL    = the POOLED string (hostname contains "-pooler") — used by the running app
# DATABASE_URL_DIRECT = the DIRECT string (no "-pooler") — used only for running migrations
DATABASE_URL=postgresql://user:password@ep-EXAMPLE-pooler.xx-example-1.aws.neon.tech/ain_rwanda?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-EXAMPLE.xx-example-1.aws.neon.tech/ain_rwanda?sslmode=require

# Required — the app refuses to start without this (see README "Security
# hardening pass"). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required in production — the app refuses to start without this too, to
# avoid ever silently defaulting to an open CORS policy.
CLIENT_URL=http://localhost:3000

# File uploads (committee photos, story covers, impact report PDFs).
# From Vercel dashboard -> your project -> Storage -> create a Blob store
# -> ".env.local" tab shows this token. Required for POST /api/admin/upload
# to work; everything else in the API works fine without it.
BLOB_READ_WRITE_TOKEN=
